module

public import ShrincsSecurity.ITSR.Concrete.Certify
public import ShrincsSecurity.ITSR.Theorem2
public import ShrincsSecurity.ITSR.Concrete.Examples
public import ShrincsSecurity.ITSR.Concrete.SLH128s
public import ShrincsSecurity.ITSR.Concrete.SLH128f
public import ShrincsSecurity.ITSR.Concrete.SLH192s
public import ShrincsSecurity.ITSR.Concrete.SLH192f
public import ShrincsSecurity.ITSR.Concrete.SLH256s
public import ShrincsSecurity.ITSR.Concrete.SLH256f
public import ShrincsSecurity.ITSR.Concrete.ShrincsSl

/-!
# Concrete bounds

`ITSR-Classical.pdf`, Section 7 (Tables 2–7) and the worked example of Sections 3.3 and 4.

* `Concrete.Certify`: the certified bracket of Lemma 13 for `Γ_j(r)` (`gamma_le_gammaHiQ`), the
  terms of Theorem 2 as rational functions of upper bounds on `Γ_j` (`mainBound_le_Q`, …), and
  `le_two_rpow_of_check`, which turns a rational inequality `x^100 ≤ 2^B` checked by
  `decide +kernel` into `X ≤ 2^(B / 100)`. Also `theta_fin_two_pow : theta (Fin (2^h)) = 1 / 2^h`.
* One module per parameter set of Table 2 (`SLH128s`, `SLH128f`, `SLH192s`, `SLH192f`, `SLH256s`,
  `SLH256f`, `ShrincsSl`), each with
  - `gamma_le`: kernel-checked dyadic upper bounds on `Γ_j(r)`, `j ≤ k`;
  - `table3_q1`, `table3_q2e…`: the exact columns of Table 3 (search term, `|K|`-term, `T₁`, `T₂`,
    the bound of Theorem 2, and the gap of more than 88.9 bits to the `|K|`-term of Theorem 1);
  - `table3_qStar`: the last row of Table 3, at an explicit `qStar ≥ 2^(q* - 0.01)` at which the
    `|K|`-term is at most `1`;
  - `table4_q2e…` / `table5_q2e…`: the exact columns of Tables 4 and 5 (search term, `T₁`, `R₂` and
    the bound of Theorem 2);
  - `table7_gamma` (`Γ_k(r) ≤ 2^-(x^ex - 0.01)`) and `table7_qOne` (the bound is at most `1` at an
    explicit `qOne ≥ 2^(q₁ - 0.01)`); at SHRINCS-sl also `table6_terms` (`T₁, …, T₁₀` at
    `q = ⌊2^122.35⌋`, last row of Table 6).
  Every printed figure `v` of these columns is certified as `term ≤ 2^(v + 0.01)`, i.e. the
  paper's rounding to two decimals plus one unit in the last place.
* `Concrete.Examples`: `(Γ_j(1)) = (1, 1/4, 1/8)`, `(Γ_j(2)) = (1, 7/16, 17/64)` at
  `(h, t, k) = (1, 2, 2)`, and the bounds `3/4` vs `7/8` (`r = 1`) and `15/8` vs `115/64` (`r = 2`)
  of Theorems 2 and 1 at `|K| = 4`, `q = 2`.

The per-set modules are generated by `Concrete/generate.py`, which mirrors the rational
computations of `Concrete.Certify` and emits only goals that it has checked to hold; the kernel
re-checks every one of them.

* `Concrete.advantage_le_of_mainBound_le` connects any concrete `mainBound` upper bound at
  `θ = 1 / 2^h` and `|K| = 2^lK` directly to `ITSR.advantage A` via `ITSR.advantage_le_mainBound`.
-/

@[expose] public section

namespace ShrincsSecurity.ITSR.Concrete

open scoped ENNReal

/-- **End-to-end game bridge for `ITSR/Concrete/`**: any certified bound
`mainBound (1 / 2^h) t k r q (2^lK) ≤ B` yields `ITSR.advantage A ≤ ENNReal.ofReal B` for every
classical ROM adversary `A` with key space `Fin (2^lK)`, instance space `Fin (2^h)`, `q` direct
queries and `r` challenge queries (Theorem 2, `ITSR.advantage_le_mainBound`). -/
theorem advantage_le_of_mainBound_le {M : Type} [DecidableEq M] {h k t r q lK : ℕ} [NeZero t]
    {B : ℝ} (hB : mainBound (1 / 2 ^ h) t k r q (2 ^ lK) ≤ B)
    (A : Adversary (Fin (2 ^ lK)) M (Digest (Fin (2 ^ h)) k t) q r) :
    advantage A ≤ ENNReal.ofReal B := by
  refine (advantage_le_mainBound A).trans (ENNReal.ofReal_le_ofReal ?_)
  rw [theta_fin_two_pow, Fintype.card_fin]
  exact hB

/-- End-to-end instance (Table 3, SHRINCS-sl, `q = 2^64`): every classical ROM adversary against
SHRINCS-sl's FORS parameters with `2^64` direct queries and `2^40` challenges succeeds with
probability at most `2^(-66.23)`. -/
theorem ShrincsSl.advantage_le_q2e64 {M : Type} [DecidableEq M]
    (A : Adversary (Fin (2 ^ 128)) M (Digest (Fin (2 ^ 45)) 10 (2 ^ 13)) (2 ^ 64) (2 ^ 40)) :
    advantage A ≤ ENNReal.ofReal ((2 : ℝ) ^ (-66.23 : ℝ)) :=
  advantage_le_of_mainBound_le ShrincsSl.table3_q2e64.2.2.2.2.1 A

/-- End-to-end instance (Table 3, SLH-DSA-128s, `q = 2^64`): every classical ROM adversary against
SLH-DSA-128s's FORS parameters with `2^64` direct queries and `2^64` challenges succeeds with
probability at most `2^(-69.74)`. -/
theorem SLH128s.advantage_le_q2e64 {M : Type} [DecidableEq M]
    (A : Adversary (Fin (2 ^ 128)) M (Digest (Fin (2 ^ 63)) 14 (2 ^ 12)) (2 ^ 64) (2 ^ 64)) :
    advantage A ≤ ENNReal.ofReal ((2 : ℝ) ^ (-69.74 : ℝ)) :=
  advantage_le_of_mainBound_le SLH128s.table3_q2e64.2.2.2.2.1 A

end ShrincsSecurity.ITSR.Concrete

end
